int findNumbers(int* nums, int numsSize) {
    int evenCount = 0;

    for (int i = 0; i < numsSize; i++) {
        int digits = 0;
        int n = nums[i];

        while (n > 0) {
            n /= 10;
            digits++;
        }

        if (digits % 2 == 0) {
            evenCount++;
        }
    }

    return evenCount;
}
